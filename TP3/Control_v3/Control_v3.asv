%% ================================
%    CALCULO DE GANANCIA K
%    PARA BALL & BEAM DISCRETO
% =================================


%% --- Matrices discretas del modelo ---
Ad = [ 1.0000   0.02     0.0       0.0;
       0.0     0.9453   0.196     0.0;
       0.0      0.0      1.0      0.02;
       0.0      0.0    -10.7660   0.3392 ];

Bd = [ 0.0;
       0.0;
       0.0;
       3.696 ];
   
 
% Usar solo la fila del output controlado
% Si querés regular posición (y = x1):
Cd=[ 1 0 0 0;
    0 0 1 0 ];
C = Cd(1,:); % <-- elegís la salida a unity gain

K = [1.327624, 0.71637, -0.174823, 0.046391];


Ts = 0.02;    % tiempo de muestreo

nx = size(Ad,1);       % cantidad de estados
ny = size(C,1);        % cantidad de salidas

% ====== MATRICES EXTENDIDAS ======
Ae = [Ad            zeros(nx,ny);
      -C*Ts         eye(ny)]

Be = [Bd;
      zeros(ny, size(Bd,2))]

% Entrada de referencia (para usar si querés feedforward)
Ee = [zeros(nx,ny);
      Ts*eye(ny)];

disp("Ae = "); disp(Ae);
disp("Be = "); disp(Be);
disp("Ee = "); disp(Ee);


sysd = ss(Ae, Be, eye(size(Ae)), zeros(size(Ae,1), size(Be,2)), Ts);
sysc = d2c(sysd);      % <-- conversión automática a continuo

Ac = sysc.A;
Bc = sysc.B;

eig(Ac)                % polos continuos
%% ====== DISEÑO DE K y H ======
%Polos de la planta continuos
% 
%    0.0000 + 0.0000i
%   -2.7375 + 0.0000i
%  -16.5200 +16.2908i
%  -16.5200 -16.2908i

poles_c = [-2, -4, -17+17i, -17-19i, -3];



% Elegí polos deseados en discreto (ejemplo)


%poles_d = [0.6236, 0.7536, 0.8974, 0.97, 0.98];   % tantos polos como nx+ny
poles_d =exp(poles_c * Ts)
% Control por asignación de polos:
Ke = place(Ae, Be, poles_d)
disp(' Autovalores lazo cerrado (PLACE):')
disp(eig(Ae - Be*Ke))

%K = [ 1.94, 0.871637, -0.2, 0.02 -1.5]; 
K = [ 2.03534071, 0.90801508, -0.19107170, 0.01730844 -1.70]; 
K = [-270.8133   -89.0135  1.1193    0.0354 205.7618];
disp(' Autovalores lazo cerrado (A mano):')
disp(eig(Ae - Be*K))

%%
K = Ke(1:nx);        % parte correspondiente a estados
H = Ke(nx+1:end);    % parte correspondiente al integrador

fprintf("\n--- COPIAR A ARDUINO ---\n");

%// ========================
%// PRINT VECTOR K
%// ========================
fprintf("\n// Ganancia K\n");
fprintf("float K[%d] = {", length(K));

for i = 1:length(K)
    if i < length(K)
        fprintf("%.8f, ", K(i));
    else
        fprintf("%.8f", K(i));   % última sin coma
    end
end
fprintf("};\n");

%// ========================
%// PRINT VECTOR H
%// ========================
fprintf("\n// Ganancia H (integrador)\n");
fprintf("float H = %.8f; \n", H);



